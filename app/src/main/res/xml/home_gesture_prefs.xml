<?xml version="1.0" encoding="utf-8"?>
<!--
  手势一级页：顶部「权限与后台」状态卡 + 入口卡列表。
  功能引导统一收进页头右上角的「?」入口，不再占用首屏横幅。
  状态卡摘要显示体检表待处理项数（GestureHomeFragment 绑定，onResume 刷新）；
  入口卡徽章：无障碍开关 / 轮盘个数 / 当前小窗模式。
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 权限与后台状态卡：整卡与动作按钮都进入体检表页面。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeStatusCardPreference
        android:icon="@drawable/icon_lock"
        android:key="preferenceSetupStatus"
        app:statusCardActionLabel="@string/setup_check_action_review" />

    <!-- 无障碍服务：原轮播状态页下沉为入口卡，徽章显示已开启/未开启。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/icon_service"
        android:key="preferenceAccessibility"
        android:summary="@string/home_summary_service"
        app:title="@string/home_status_service_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_gesture_24"
        android:key="preferenceConfigTrigger"
        android:summary="@string/home_summary_gesture"
        app:title="@string/settings_gesture_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_pie_chart_24"
        android:key="preferenceActionView"
        android:summary="@string/home_summary_action_view"
        app:title="@string/action_view_settings_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/ic_little_window"
        android:key="preferenceFreeform"
        android:summary="@string/home_summary_freeform"
        app:title="@string/freeform_settings_title" />

</PreferenceScreen>
