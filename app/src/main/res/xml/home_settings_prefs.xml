<?xml version="1.0" encoding="utf-8"?>
<!--
  设置一级页：顶部「功能介绍与引导」横幅（静态，轮播已取消），
  下方为入口卡列表。原轮播第 1 页的外观主题状态下沉为入口卡（置顶），
  摘要动态显示当前配色（SettingsHomeFragment 绑定，onResume 刷新）；
  「权限与后台」卡的徽章显示待处理项数。
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 功能介绍与引导横幅：整卡点击与动作按钮都打开分步引导。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeStatusCardPreference
        android:icon="@drawable/baseline_info_24"
        android:key="preferenceAppearance"
        app:statusCardActionLabel="@string/home_guide_action" />

    <!-- 外观主题：原轮播状态页下沉为入口卡，摘要在 Fragment 中动态刷新。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_auto_awesome_24"
        android:key="preferenceAppearanceEntry"
        app:title="@string/home_status_theme_title" />

    <!-- 权限与后台管理：原「设置检查」与「后台稳定性」合并后的宿主页。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/icon_lock"
        android:key="preferenceSetupCheck"
        app:title="@string/setup_check_entry_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_save_24"
        android:key="preferenceData"
        android:summary="@string/home_summary_data"
        app:title="@string/data_backup_title" />

    <!-- 高级设置：外部功能调用、授权记录与维护日志的宿主页。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_settings_24"
        android:key="preferenceAdvanced"
        android:summary="@string/home_summary_advanced"
        app:title="@string/advanced_settings_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_info_24"
        android:key="preferenceAbout"
        android:summary="@string/home_summary_about"
        app:title="@string/settings_about_title" />

</PreferenceScreen>
