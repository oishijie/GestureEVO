<?xml version="1.0" encoding="utf-8"?>
<!--
  搜索一级页：顶部引导状态卡 + 入口卡列表。
  「搜索列表」与「自定义设置」深链打开原版 SearchEngineSettingsActivity 对应分区卡
  （引擎列表 / 显示+功能+启动）；「导入」「导出」直接执行。
  分组标题已取消；徽章显示引擎个数（SearchHomeFragment 绑定，onResume 刷新）。
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 引导状态卡：始终可见。 -->
    <io.github.lumiagg.gestureevo.ui.home.HomeStatusCardPreference
        android:icon="@drawable/baseline_info_24"
        android:key="card_search_guide"
        app:statusCardActionLabel="@string/home_guide_action" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/search_24px"
        android:key="menu_search_engines"
        android:summary="@string/home_menu_engines_summary"
        app:title="@string/home_menu_engines_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/baseline_settings_24"
        android:key="menu_search_settings"
        android:summary="@string/home_menu_search_settings_summary"
        app:title="@string/home_menu_search_settings_title" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/content_paste_go_20px"
        android:key="menu_search_import"
        android:summary="@string/search_engine_settings_import_summary"
        app:title="@string/search_engine_settings_import" />

    <io.github.lumiagg.gestureevo.ui.home.HomeEntryPreference
        android:icon="@drawable/ic_baseline_content_copy_24"
        android:key="menu_search_export"
        android:summary="@string/search_engine_settings_export_summary"
        app:title="@string/search_engine_settings_export" />

</PreferenceScreen>
