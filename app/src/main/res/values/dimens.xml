<resources>
    <dimen name="app_bar_height">140dp</dimen>
    <dimen name="slide_offset">64dp</dimen>
    <dimen name="quick_search_motion_offset_medium">56dp</dimen>
    <dimen name="quick_search_motion_offset_large">72dp</dimen>
    <dimen name="settings_card_spacing">8dp</dimen>
    <dimen name="settings_card_corner_radius">16dp</dimen>
    <!--
      悬浮底栏：
      home_bottom_bar_margin —— 底栏离屏幕底边（含导航栏）的距离
      home_content_bottom_padding —— 内容区与底栏之间的呼吸间距；实际底部留白由
        HomeActivity 按「底栏实测高度 + margin + 导航栏高度」动态计算，此值仅作最小间距与首帧兜底
      home_bottom_bar_estimated_height —— 底栏尚未完成布局时的估算高度
    -->
    <dimen name="home_bottom_bar_margin">16dp</dimen>
    <dimen name="home_content_bottom_padding">16dp</dimen>
    <dimen name="home_bottom_bar_estimated_height">64dp</dimen>

    <!--
      类型阶：全应用字号统一收敛为四档，布局一律引用此处，不再散落硬编码。
      display —— 页面大数字/强调标题；title —— 卡片标题、行标题；
      body —— 正文与摘要；label —— 徽章、标签、底栏文字。
    -->
    <dimen name="evo_text_display">20sp</dimen>
    <dimen name="evo_text_title">16sp</dimen>
    <dimen name="evo_text_body">14sp</dimen>
    <dimen name="evo_text_label">12sp</dimen>

    <!--
      形状阶：页面级容器统一四档，布局引用此处。
      chip —— 小标签/键帽；small —— 列表内小卡；card —— 页面卡片；
      sheet —— 弹层、对话框、大容器。
      悬浮小窗/浮球的圆角随窗口几何（圆形由宽高决定），不纳入本阶。
    -->
    <dimen name="shape_corner_chip">8dp</dimen>
    <dimen name="shape_corner_small">12dp</dimen>
    <dimen name="shape_corner_card">16dp</dimen>
    <dimen name="shape_corner_sheet">24dp</dimen>
</resources>
